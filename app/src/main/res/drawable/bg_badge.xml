<?xml version="1.0" encoding="utf-8"?>
<!-- 应用徽标：新拟物凸起圆角方 + 珊瑚渐变底 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="@color/soft_shadow_light" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="@color/soft_shadow_dark" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/accent"
                android:endColor="@color/accent_deep" />
        </shape>
    </item>
</layer-list>
